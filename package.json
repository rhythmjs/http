{
  "name": "@rhythmjs/http",
  "version": "0.0.6",
  "description": "HTTP utility middleware (cookies, sessions, caching, etag, compression, sse, streaming, multipart, proxy, timeout, body limit) for Rhythm routers and handlers.",
  "keywords": [
    "async-local-storage",
    "body-limit",
    "cache",
    "cache-control",
    "compression",
    "cookies",
    "etag",
    "http",
    "i18n",
    "i18next",
    "middleware",
    "multipart",
    "proxy",
    "request-scope",
    "reverse-proxy",
    "rhythm",
    "server-sent-events",
    "session",
    "sse",
    "streaming",
    "timeout"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/http.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./body-limit": {
      "types": "./dist/body-limit/body-limit.d.ts",
      "default": "./dist/body-limit/body-limit.js"
    },
    "./cache": {
      "types": "./dist/cache/cache.d.ts",
      "default": "./dist/cache/cache.js"
    },
    "./compress": {
      "types": "./dist/compress/compress.d.ts",
      "default": "./dist/compress/compress.js"
    },
    "./cookies": {
      "types": "./dist/cookies/cookies.d.ts",
      "default": "./dist/cookies/cookies.js"
    },
    "./etag": {
      "types": "./dist/etag/etag.d.ts",
      "default": "./dist/etag/etag.js"
    },
    "./i18n": {
      "types": "./dist/i18n/i18n.d.ts",
      "default": "./dist/i18n/i18n.js"
    },
    "./multipart": {
      "types": "./dist/multipart/multipart.d.ts",
      "default": "./dist/multipart/multipart.js"
    },
    "./proxy": {
      "types": "./dist/proxy/proxy.d.ts",
      "default": "./dist/proxy/proxy.js"
    },
    "./request-scope": {
      "types": "./dist/request-scope/request-scope.d.ts",
      "default": "./dist/request-scope/request-scope.js"
    },
    "./session": {
      "types": "./dist/session/session.d.ts",
      "default": "./dist/session/session.js"
    },
    "./sse": {
      "types": "./dist/sse/sse.d.ts",
      "default": "./dist/sse/sse.js"
    },
    "./stream": {
      "types": "./dist/stream/stream.d.ts",
      "default": "./dist/stream/stream.js"
    },
    "./timeout": {
      "types": "./dist/timeout/timeout.d.ts",
      "default": "./dist/timeout/timeout.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/body-limit/body-limit.ts src/cache/cache.ts src/compress/compress.ts src/cookies/cookies.ts src/etag/etag.ts src/i18n/i18n.ts src/multipart/multipart.ts src/proxy/proxy.ts src/request-scope/request-scope.ts src/session/session.ts src/sse/sse.ts src/stream/stream.ts src/timeout/timeout.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "i18next": "^26.4.2",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": "^0.0.11",
    "@rhythmjs/router": "^0.0.11",
    "i18next": "*"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
