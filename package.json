{
  "name": "@rhythmjs/http",
  "version": "0.0.5",
  "description": "HTTP utility middleware (cookies, sessions, etag, sse, streaming, multipart, timeout, body limit) for Rhythm routers and handlers.",
  "keywords": [
    "async-local-storage",
    "body-limit",
    "cookies",
    "etag",
    "http",
    "i18n",
    "i18next",
    "middleware",
    "multipart",
    "request-scope",
    "rhythm",
    "server-sent-events",
    "session",
    "sse",
    "streaming",
    "timeout"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/http.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./body-limit": {
      "types": "./dist/body-limit/body-limit.d.ts",
      "default": "./dist/body-limit/body-limit.js"
    },
    "./cookies": {
      "types": "./dist/cookies/cookies.d.ts",
      "default": "./dist/cookies/cookies.js"
    },
    "./etag": {
      "types": "./dist/etag/etag.d.ts",
      "default": "./dist/etag/etag.js"
    },
    "./i18n": {
      "types": "./dist/i18n/i18n.d.ts",
      "default": "./dist/i18n/i18n.js"
    },
    "./multipart": {
      "types": "./dist/multipart/multipart.d.ts",
      "default": "./dist/multipart/multipart.js"
    },
    "./request-scope": {
      "types": "./dist/request-scope/request-scope.d.ts",
      "default": "./dist/request-scope/request-scope.js"
    },
    "./session": {
      "types": "./dist/session/session.d.ts",
      "default": "./dist/session/session.js"
    },
    "./sse": {
      "types": "./dist/sse/sse.d.ts",
      "default": "./dist/sse/sse.js"
    },
    "./stream": {
      "types": "./dist/stream/stream.d.ts",
      "default": "./dist/stream/stream.js"
    },
    "./timeout": {
      "types": "./dist/timeout/timeout.d.ts",
      "default": "./dist/timeout/timeout.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp check && vp test && vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "i18next": "^26.4.2",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": "^0.0.9",
    "@rhythmjs/router": "^0.0.9",
    "i18next": "*"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.2"
}
